# Tool-capable OpenAI-compatible model.
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=
AGENT_API_KEY=

# Cloud web pilot.
PILOT_ACCESS_KEY=
AGENT_STATE_SECRET=

# Product locations and scoped credentials.
# Cloud mode now derives each product's remote MCP endpoint as <base-url>/mcp
# and reuses the existing product API key as its MCP bearer token.
TENDING_BASE_URL=http://localhost:3000
TENDING_API_KEY=
TENDING_VERCEL_BYPASS_SECRET=

SWELLS_BASE_URL=https://swells.app
SWELLS_API_KEY=
SWELLS_SPACE_ID=

GLADE_BASE_URL=https://ourglade.app
GLADE_API_KEY=
GLADE_VERCEL_BYPASS_SECRET=

# Optional explicit MCP overrides. Normally leave these blank.
TENDING_MCP_URL=
TENDING_MCP_BEARER_TOKEN=
SWELLS_MCP_URL=
SWELLS_MCP_BEARER_TOKEN=
GLADE_MCP_URL=
GLADE_MCP_BEARER_TOKEN=

# Optional emergency/diagnostic fallback.
# Set to direct-api to bypass product MCPs and use the HTTPS API tool hub.
ATTENTION_TOOL_MODE=

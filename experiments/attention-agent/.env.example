# Model: local OpenAI-compatible server (Ollama, LM Studio, llama.cpp) or a cloud endpoint.
# For Ollama, for example: AGENT_BASE_URL=http://127.0.0.1:11434/v1
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=
AGENT_API_KEY=

# Tending API (existing API key, preferably a pilot/dev organisation)
TENDING_BASE_URL=http://localhost:3000
TENDING_API_KEY=

# Swells temporary pilot API
SWELLS_BASE_URL=http://localhost:3001
SWELLS_AGENT_API_TOKEN=
SWELLS_SPACE_ID=

# Glade API (existing API key, preferably a pilot/dev space)
GLADE_BASE_URL=http://localhost:3002
GLADE_API_KEY=

# Optional future remote MCP endpoints. If absent, the agent starts the local stdio adapters above.
TENDING_MCP_URL=
TENDING_MCP_BEARER_TOKEN=
SWELLS_MCP_URL=
SWELLS_MCP_BEARER_TOKEN=
GLADE_MCP_URL=
GLADE_MCP_BEARER_TOKEN=

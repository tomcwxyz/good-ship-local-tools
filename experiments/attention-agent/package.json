{
  "name": "@good-ship/attention-agent-pilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cloud-first attention-agent pilot across Tending, Swells and Glade, with a local CLI option.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "agent": "node --import tsx src/agent/cli.ts",
    "agent:local": "node --import tsx src/agent/cli.ts",
    "mcp:tending": "node --import tsx src/mcp/tending.ts",
    "mcp:swells": "node --import tsx src/mcp/swells.ts",
    "mcp:glade": "node --import tsx src/mcp/glade.ts",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "^17.2.2",
    "next": "16.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6",
    "mcp-handler": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}

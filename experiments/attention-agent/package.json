{
  "name": "@good-ship/attention-agent-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first pilot agent across Tending, Swells and Glade via MCP.",
  "scripts": {
    "agent": "node --import tsx src/agent/cli.ts",
    "mcp:tending": "node --import tsx src/mcp/tending.ts",
    "mcp:swells": "node --import tsx src/mcp/swells.ts",
    "mcp:glade": "node --import tsx src/mcp/glade.ts",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "^17.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
